# Servidor
PORT=3000
NODE_ENV=development

# CORS — separe múltiplas origens com vírgula (usado apenas em produção)
CORS_ORIGIN=http://localhost:3000

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/petora?schema=public"

# Autenticação JWT
# Gere um segredo forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte
# Expiração do token (padrão: 8h)
JWT_EXPIRES_IN=8h
